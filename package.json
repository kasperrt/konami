{
  "name": "@kasperrt/konami",
  "version": "0.0.1",
  "description": "A tiny, dependency-free keyboard sequence listener with a callback-first API.",
  "type": "module",
  "keywords": [
    "konami",
    "konami-code",
    "keyboard",
    "keyboard-shortcut",
    "easter-egg",
    "browser",
    "typescript",
    "zero-dependency"
  ],
  "author": "Kasper Rynning-Tønnesen <kasperrt@users.noreply.github.com> (https://github.com/kasperrt)",
  "license": "MIT",
  "homepage": "https://github.com/kasperrt/konami#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kasperrt/konami.git"
  },
  "bugs": {
    "url": "https://github.com/kasperrt/konami/issues"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && tsc --project tsconfig.build.json",
    "check": "biome check . && tsc --noEmit",
    "test": "npm run build && tsc --project tsconfig.test.json && vitest run",
    "pack:check": "publint && attw --pack --profile esm-only",
    "fix": "biome check --write .",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "smoke:browser": "node scripts/smoke-browser.mjs",
    "test:coverage": "npm test"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.4",
    "@vitest/coverage-v8": "4.1.11",
    "playwright": "1.64.1",
    "publint": "0.3.25",
    "terser": "5.51.0",
    "typescript": "7.0.2",
    "vite": "8.1.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=18"
  }
}
